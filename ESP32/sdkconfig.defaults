# 工程级 sdkconfig 默认配置（PlatformIO 自动合并到 sdkconfig.esp32-s3）

# 主 console 走 UART0（GPIO43/44，接 USB-TTL → COM12）
# 选 UART0 原因：USB-Serial/JTAG（COM10）在宿主机打开/关闭串口时会触发芯片复位
# （rst:0x15 USB_UART_CHIP_RESET），调试时日志会中断；UART0 不受影响。
# 若需切回 USB-Serial/JTAG：把下面改为 CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set

# 启用外部 PSRAM：本板芯片为 ESP32-S3R8（内置 8MB Octal PSRAM）
# 屏幕 ST77926 全帧缓冲（320x480x2=300KB）放入 PSRAM，QSPI 按帧刷新可达 60Hz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# LVGL 9.x：启用矩阵支持（横屏旋转 LV_DISPLAY_ROTATION_90 必需）
# LV_DRAW_TRANSFORM_USE_MATRIX 依赖 LV_USE_MATRIX，后者 select LV_USE_FLOAT
CONFIG_LV_USE_FLOAT=y
CONFIG_LV_USE_MATRIX=y
CONFIG_LV_DRAW_TRANSFORM_USE_MATRIX=y

# 自定义 LVGL 字体使用压缩位图格式
CONFIG_LV_USE_FONT_COMPRESSED=y
