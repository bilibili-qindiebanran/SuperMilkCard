# ===== ESP32（Arduino / PlatformIO / ESP-IDF）=====

# 编译输出目录
ESP32/build/
ESP32/.pio/
ESP32/.pioenvs/
ESP32/.piolibdeps/
ESP32/managed_components/
ESP32/dependencies.lock
ESP32/sdkconfig.old

# ESP-IDF / PlatformIO 构建时自动生成的文件
# （注意保留可提交的 sdkconfig.defaults / sdkconfig.defaults.<target>）
ESP32/sdkconfig
ESP32/sdkconfig.esp32*
ESP32/CMakeLists.txt
ESP32/src/CMakeLists.txt

# 固件与中间产物
ESP32/**/*.bin
ESP32/**/*.hex
ESP32/**/*.elf
ESP32/**/*.map
ESP32/**/*.o

